;  SCENE
; ══════════════════════════════════════════════

[node name="UpgradeMenu" type="CanvasLayer"]
script = ExtResource("1_menu")
layer = 20
visible = false

; Тёмный оверлей
[node name="Dimmer" type="ColorRect" parent="."]
